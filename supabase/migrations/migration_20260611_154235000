-- Create activities table
CREATE TABLE IF NOT EXISTS activities (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  event_id UUID NOT NULL REFERENCES events(id) ON DELETE CASCADE,
  parent_id UUID REFERENCES activities(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  code TEXT NOT NULL,
  description TEXT,
  category TEXT,
  points_value INTEGER DEFAULT 10,
  status TEXT DEFAULT 'active' CHECK (status IN ('active','inactive','archived')),
  icon_name TEXT DEFAULT 'Zap',
  color TEXT DEFAULT 'hsl(0 85% 52%)',
  sort_order INTEGER DEFAULT 0,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  created_by UUID REFERENCES auth.users(id),
  UNIQUE (event_id, code)
);

-- RLS
ALTER TABLE activities ENABLE ROW LEVEL SECURITY;

CREATE POLICY "activities_select_anon" ON activities FOR SELECT USING (true);
CREATE POLICY "activities_select_auth" ON activities FOR SELECT TO authenticated USING (true);
CREATE POLICY "activities_insert_admin" ON activities FOR INSERT TO authenticated WITH CHECK (get_my_role() = 'admin');
CREATE POLICY "activities_update_admin" ON activities FOR UPDATE TO authenticated USING (get_my_role() = 'admin');
CREATE POLICY "activities_delete_admin" ON activities FOR DELETE TO authenticated USING (get_my_role() = 'admin');

-- Realtime
ALTER PUBLICATION supabase_realtime ADD TABLE activities;

-- Add activity_id FK to activity_logs
ALTER TABLE activity_logs ADD COLUMN IF NOT EXISTS activity_id UUID REFERENCES activities(id);

