-- RPC: ensure_event_channels — auto-create the 4 standard group channels
-- ══════════════════════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION ensure_event_channels(p_event_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_channel_id uuid;
  v_role       text;
  v_staff_id   uuid := auth.uid();
BEGIN
  -- Get caller's role
  SELECT role INTO v_role FROM staff_profiles WHERE id = v_staff_id;

  -- 1. Event Operations (all roles)
  INSERT INTO comm_channels (event_id, type, name, slug, allowed_roles)
  VALUES (p_event_id, 'group', 'Event Operations', 'event_ops', NULL)
  ON CONFLICT (event_id, slug) DO NOTHING;

  -- 2. Check-In Team
  INSERT INTO comm_channels (event_id, type, name, slug, allowed_roles)
  VALUES (p_event_id, 'group', 'Check-In Team', 'checkin_team', ARRAY['admin','event_admin','checkin_officer'])
  ON CONFLICT (event_id, slug) DO NOTHING;

  -- 3. Activity Team
  INSERT INTO comm_channels (event_id, type, name, slug, allowed_roles)
  VALUES (p_event_id, 'group', 'Activity Team', 'activity_team', ARRAY['admin','event_admin','activity_coordinator'])
  ON CONFLICT (event_id, slug) DO NOTHING;

  -- 4. Leadership
  INSERT INTO comm_channels (event_id, type, name, slug, allowed_roles)
  VALUES (p_event_id, 'group', 'Leadership', 'leadership', ARRAY['admin','event_admin'])
  ON CONFLICT (event_id, slug) DO NOTHING;

  -- Add caller to channels they're eligible for
  FOR v_channel_id IN
    SELECT id FROM comm_channels
    WHERE event_id = p_event_id
      AND (allowed_roles IS NULL OR v_role = ANY(allowed_roles))
  LOOP
    INSERT INTO comm_channel_members (channel_id, staff_id)
    VALUES (v_channel_id, v_staff_id)
    ON CONFLICT (channel_id, staff_id) DO NOTHING;
  END LOOP;
END;
$$;

-- ══════════════════════════════════════════════════════════════════════════════
-- RPC: get_or_create_dm — find or create a DM channel between two staff
-- ══════════════════════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION get_or_create_dm(p_other_staff_id uuid)
RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_my_id     uuid := auth.uid();
  v_channel_id uuid;
BEGIN
  -- Look for existing DM between these two users
  SELECT c.id INTO v_channel_id
  FROM comm_channels c
  JOIN comm_channel_members m1 ON m1.channel_id = c.id AND m1.staff_id = v_my_id
  JOIN comm_channel_members m2 ON m2.channel_id = c.id AND m2.staff_id = p_other_staff_id
  WHERE c.type = 'dm'
  LIMIT 1;

  IF v_channel_id IS NOT NULL THEN
    RETURN v_channel_id;
  END IF;

  -- Create new DM channel
  INSERT INTO comm_channels (type, event_id, created_by)
  SELECT 'dm', NULL, v_my_id
  RETURNING id INTO v_channel_id;

  -- Add both members
  INSERT INTO comm_channel_members (channel_id, staff_id) VALUES (v_channel_id, v_my_id);
  INSERT INTO comm_channel_members (channel_id, staff_id) VALUES (v_channel_id, p_other_staff_id);

  RETURN v_channel_id;
END;
$$;
